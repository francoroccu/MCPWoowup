# ─── Base de datos (Neon / Vercel Postgres) ───────────────────────────
# Sin DATABASE_URL la plataforma arranca en MODO DEMO con datos ficticios.
DATABASE_URL=

# ─── Acceso del equipo ───────────────────────────────────────────────
# Contraseña compartida del equipo Patagonia Digital.
# AUTH_DISABLED=true  → sin login (la protección queda a cargo de Vercel)
APP_PASSWORD=
# Clave para firmar la cookie de sesión (cualquier string largo y aleatorio).
AUTH_SECRET=

# ─── Servidor MCP de WoowUp ──────────────────────────────────────────
# URL del endpoint MCP (Streamable HTTP), ej: https://mcp.woowup.com/mcp
WOOWUP_MCP_URL=
# Token de acceso al MCP. Se envía en el header indicado abajo.
WOOWUP_MCP_TOKEN=
# Header de auth (por defecto "Authorization", con prefijo "Bearer ").
WOOWUP_MCP_AUTH_HEADER=Authorization
WOOWUP_MCP_AUTH_PREFIX=Bearer
# Sesiones MCP en paralelo durante la sincronización (cada una recorre cuentas distintas).
SYNC_CONCURRENCY=3

# ─── Cron de Vercel ──────────────────────────────────────────────────
# Vercel lo envía como "Authorization: Bearer <CRON_SECRET>" al llamar /api/cron/sync
CRON_SECRET=
